(version 1)

# Isolation rules for master_sense_buses. Net groups taken from the schematic netlist.
# Line side = phase (GND_PH star), mains reference (GNDREF) and DC bus (RECT -) domains; everything else is logic.

(rule "isolation: logic side to line side (8 mm, matches the module/isolator pin spacing)"
	(constraint clearance (min 8mm))
	(condition "((A.NetName == 'BIAS_PH' || A.NetName == 'GND_PH' || A.NetName == 'Net-(C37-Pad2)' || A.NetName == 'Net-(R18-Pad1)' || A.NetName == 'Net-(R19-Pad1)' || A.NetName == 'Net-(R20-Pad1)' || A.NetName == 'Net-(R21-Pad1)' || A.NetName == 'Net-(R22-Pad1)' || A.NetName == 'Net-(R23-Pad1)' || A.NetName == 'Net-(R24-Pad1)' || A.NetName == 'Net-(R25-Pad1)' || A.NetName == 'Net-(R26-Pad1)' || A.NetName == 'Net-(U4-VIN)' || A.NetName == 'Net-(U5-VIN)' || A.NetName == 'Net-(U6-VIN)' || A.NetName == 'Net-(U9-IN+)' || A.NetName == 'VISO_PH' || A.NetName == 'ϕA' || A.NetName == 'ϕB' || A.NetName == 'ϕC' || A.NetName == 'BIAS_REF' || A.NetName == 'GNDREF' || A.NetName == 'Net-(C29-Pad2)' || A.NetName == 'Net-(R30-Pad1)' || A.NetName == 'Net-(R30-Pad2)' || A.NetName == 'Net-(R31-Pad1)' || A.NetName == 'Net-(U10-IN+)' || A.NetName == 'Net-(U7-VIN)' || A.NetName == 'VAC' || A.NetName == 'VISO_REF' || A.NetName == '+VDC' || A.NetName == 'DC_RET' || A.NetName == 'Net-(C33-Pad2)' || A.NetName == 'Net-(R44-Pad1)' || A.NetName == 'Net-(R46-Pad1)' || A.NetName == 'Net-(R47-Pad1)' || A.NetName == 'Net-(U14-VIN)' || A.NetName == 'Net-(U8-INN)' || A.NetName == 'Net-(U8-INP)' || A.NetName == 'RECT -' || A.NetName == 'VISO_DC') && B.NetName != '' && !(B.NetName == 'BIAS_PH' || B.NetName == 'GND_PH' || B.NetName == 'Net-(C37-Pad2)' || B.NetName == 'Net-(R18-Pad1)' || B.NetName == 'Net-(R19-Pad1)' || B.NetName == 'Net-(R20-Pad1)' || B.NetName == 'Net-(R21-Pad1)' || B.NetName == 'Net-(R22-Pad1)' || B.NetName == 'Net-(R23-Pad1)' || B.NetName == 'Net-(R24-Pad1)' || B.NetName == 'Net-(R25-Pad1)' || B.NetName == 'Net-(R26-Pad1)' || B.NetName == 'Net-(U4-VIN)' || B.NetName == 'Net-(U5-VIN)' || B.NetName == 'Net-(U6-VIN)' || B.NetName == 'Net-(U9-IN+)' || B.NetName == 'VISO_PH' || B.NetName == 'ϕA' || B.NetName == 'ϕB' || B.NetName == 'ϕC' || B.NetName == 'BIAS_REF' || B.NetName == 'GNDREF' || B.NetName == 'Net-(C29-Pad2)' || B.NetName == 'Net-(R30-Pad1)' || B.NetName == 'Net-(R30-Pad2)' || B.NetName == 'Net-(R31-Pad1)' || B.NetName == 'Net-(U10-IN+)' || B.NetName == 'Net-(U7-VIN)' || B.NetName == 'VAC' || B.NetName == 'VISO_REF' || B.NetName == '+VDC' || B.NetName == 'DC_RET' || B.NetName == 'Net-(C33-Pad2)' || B.NetName == 'Net-(R44-Pad1)' || B.NetName == 'Net-(R46-Pad1)' || B.NetName == 'Net-(R47-Pad1)' || B.NetName == 'Net-(U14-VIN)' || B.NetName == 'Net-(U8-INN)' || B.NetName == 'Net-(U8-INP)' || B.NetName == 'RECT -' || B.NetName == 'VISO_DC')) || ((B.NetName == 'BIAS_PH' || B.NetName == 'GND_PH' || B.NetName == 'Net-(C37-Pad2)' || B.NetName == 'Net-(R18-Pad1)' || B.NetName == 'Net-(R19-Pad1)' || B.NetName == 'Net-(R20-Pad1)' || B.NetName == 'Net-(R21-Pad1)' || B.NetName == 'Net-(R22-Pad1)' || B.NetName == 'Net-(R23-Pad1)' || B.NetName == 'Net-(R24-Pad1)' || B.NetName == 'Net-(R25-Pad1)' || B.NetName == 'Net-(R26-Pad1)' || B.NetName == 'Net-(U4-VIN)' || B.NetName == 'Net-(U5-VIN)' || B.NetName == 'Net-(U6-VIN)' || B.NetName == 'Net-(U9-IN+)' || B.NetName == 'VISO_PH' || B.NetName == 'ϕA' || B.NetName == 'ϕB' || B.NetName == 'ϕC' || B.NetName == 'BIAS_REF' || B.NetName == 'GNDREF' || B.NetName == 'Net-(C29-Pad2)' || B.NetName == 'Net-(R30-Pad1)' || B.NetName == 'Net-(R30-Pad2)' || B.NetName == 'Net-(R31-Pad1)' || B.NetName == 'Net-(U10-IN+)' || B.NetName == 'Net-(U7-VIN)' || B.NetName == 'VAC' || B.NetName == 'VISO_REF' || B.NetName == '+VDC' || B.NetName == 'DC_RET' || B.NetName == 'Net-(C33-Pad2)' || B.NetName == 'Net-(R44-Pad1)' || B.NetName == 'Net-(R46-Pad1)' || B.NetName == 'Net-(R47-Pad1)' || B.NetName == 'Net-(U14-VIN)' || B.NetName == 'Net-(U8-INN)' || B.NetName == 'Net-(U8-INP)' || B.NetName == 'RECT -' || B.NetName == 'VISO_DC') && A.NetName != '' && !(A.NetName == 'BIAS_PH' || A.NetName == 'GND_PH' || A.NetName == 'Net-(C37-Pad2)' || A.NetName == 'Net-(R18-Pad1)' || A.NetName == 'Net-(R19-Pad1)' || A.NetName == 'Net-(R20-Pad1)' || A.NetName == 'Net-(R21-Pad1)' || A.NetName == 'Net-(R22-Pad1)' || A.NetName == 'Net-(R23-Pad1)' || A.NetName == 'Net-(R24-Pad1)' || A.NetName == 'Net-(R25-Pad1)' || A.NetName == 'Net-(R26-Pad1)' || A.NetName == 'Net-(U4-VIN)' || A.NetName == 'Net-(U5-VIN)' || A.NetName == 'Net-(U6-VIN)' || A.NetName == 'Net-(U9-IN+)' || A.NetName == 'VISO_PH' || A.NetName == 'ϕA' || A.NetName == 'ϕB' || A.NetName == 'ϕC' || A.NetName == 'BIAS_REF' || A.NetName == 'GNDREF' || A.NetName == 'Net-(C29-Pad2)' || A.NetName == 'Net-(R30-Pad1)' || A.NetName == 'Net-(R30-Pad2)' || A.NetName == 'Net-(R31-Pad1)' || A.NetName == 'Net-(U10-IN+)' || A.NetName == 'Net-(U7-VIN)' || A.NetName == 'VAC' || A.NetName == 'VISO_REF' || A.NetName == '+VDC' || A.NetName == 'DC_RET' || A.NetName == 'Net-(C33-Pad2)' || A.NetName == 'Net-(R44-Pad1)' || A.NetName == 'Net-(R46-Pad1)' || A.NetName == 'Net-(R47-Pad1)' || A.NetName == 'Net-(U14-VIN)' || A.NetName == 'Net-(U8-INN)' || A.NetName == 'Net-(U8-INP)' || A.NetName == 'RECT -' || A.NetName == 'VISO_DC'))")
)

(rule "line side: phase / mains / DC domains apart"
	(constraint clearance (min 2.5mm))
	(condition "((A.NetName == 'BIAS_PH' || A.NetName == 'GND_PH' || A.NetName == 'Net-(C37-Pad2)' || A.NetName == 'Net-(R18-Pad1)' || A.NetName == 'Net-(R19-Pad1)' || A.NetName == 'Net-(R20-Pad1)' || A.NetName == 'Net-(R21-Pad1)' || A.NetName == 'Net-(R22-Pad1)' || A.NetName == 'Net-(R23-Pad1)' || A.NetName == 'Net-(R24-Pad1)' || A.NetName == 'Net-(R25-Pad1)' || A.NetName == 'Net-(R26-Pad1)' || A.NetName == 'Net-(U4-VIN)' || A.NetName == 'Net-(U5-VIN)' || A.NetName == 'Net-(U6-VIN)' || A.NetName == 'Net-(U9-IN+)' || A.NetName == 'VISO_PH' || A.NetName == 'ϕA' || A.NetName == 'ϕB' || A.NetName == 'ϕC') && (B.NetName == 'BIAS_REF' || B.NetName == 'GNDREF' || B.NetName == 'Net-(C29-Pad2)' || B.NetName == 'Net-(R30-Pad1)' || B.NetName == 'Net-(R30-Pad2)' || B.NetName == 'Net-(R31-Pad1)' || B.NetName == 'Net-(U10-IN+)' || B.NetName == 'Net-(U7-VIN)' || B.NetName == 'VAC' || B.NetName == 'VISO_REF')) || ((B.NetName == 'BIAS_PH' || B.NetName == 'GND_PH' || B.NetName == 'Net-(C37-Pad2)' || B.NetName == 'Net-(R18-Pad1)' || B.NetName == 'Net-(R19-Pad1)' || B.NetName == 'Net-(R20-Pad1)' || B.NetName == 'Net-(R21-Pad1)' || B.NetName == 'Net-(R22-Pad1)' || B.NetName == 'Net-(R23-Pad1)' || B.NetName == 'Net-(R24-Pad1)' || B.NetName == 'Net-(R25-Pad1)' || B.NetName == 'Net-(R26-Pad1)' || B.NetName == 'Net-(U4-VIN)' || B.NetName == 'Net-(U5-VIN)' || B.NetName == 'Net-(U6-VIN)' || B.NetName == 'Net-(U9-IN+)' || B.NetName == 'VISO_PH' || B.NetName == 'ϕA' || B.NetName == 'ϕB' || B.NetName == 'ϕC') && (A.NetName == 'BIAS_REF' || A.NetName == 'GNDREF' || A.NetName == 'Net-(C29-Pad2)' || A.NetName == 'Net-(R30-Pad1)' || A.NetName == 'Net-(R30-Pad2)' || A.NetName == 'Net-(R31-Pad1)' || A.NetName == 'Net-(U10-IN+)' || A.NetName == 'Net-(U7-VIN)' || A.NetName == 'VAC' || A.NetName == 'VISO_REF')) || ((A.NetName == 'BIAS_PH' || A.NetName == 'GND_PH' || A.NetName == 'Net-(C37-Pad2)' || A.NetName == 'Net-(R18-Pad1)' || A.NetName == 'Net-(R19-Pad1)' || A.NetName == 'Net-(R20-Pad1)' || A.NetName == 'Net-(R21-Pad1)' || A.NetName == 'Net-(R22-Pad1)' || A.NetName == 'Net-(R23-Pad1)' || A.NetName == 'Net-(R24-Pad1)' || A.NetName == 'Net-(R25-Pad1)' || A.NetName == 'Net-(R26-Pad1)' || A.NetName == 'Net-(U4-VIN)' || A.NetName == 'Net-(U5-VIN)' || A.NetName == 'Net-(U6-VIN)' || A.NetName == 'Net-(U9-IN+)' || A.NetName == 'VISO_PH' || A.NetName == 'ϕA' || A.NetName == 'ϕB' || A.NetName == 'ϕC') && (B.NetName == '+VDC' || B.NetName == 'DC_RET' || B.NetName == 'Net-(C33-Pad2)' || B.NetName == 'Net-(R44-Pad1)' || B.NetName == 'Net-(R46-Pad1)' || B.NetName == 'Net-(R47-Pad1)' || B.NetName == 'Net-(U14-VIN)' || B.NetName == 'Net-(U8-INN)' || B.NetName == 'Net-(U8-INP)' || B.NetName == 'RECT -' || B.NetName == 'VISO_DC')) || ((B.NetName == 'BIAS_PH' || B.NetName == 'GND_PH' || B.NetName == 'Net-(C37-Pad2)' || B.NetName == 'Net-(R18-Pad1)' || B.NetName == 'Net-(R19-Pad1)' || B.NetName == 'Net-(R20-Pad1)' || B.NetName == 'Net-(R21-Pad1)' || B.NetName == 'Net-(R22-Pad1)' || B.NetName == 'Net-(R23-Pad1)' || B.NetName == 'Net-(R24-Pad1)' || B.NetName == 'Net-(R25-Pad1)' || B.NetName == 'Net-(R26-Pad1)' || B.NetName == 'Net-(U4-VIN)' || B.NetName == 'Net-(U5-VIN)' || B.NetName == 'Net-(U6-VIN)' || B.NetName == 'Net-(U9-IN+)' || B.NetName == 'VISO_PH' || B.NetName == 'ϕA' || B.NetName == 'ϕB' || B.NetName == 'ϕC') && (A.NetName == '+VDC' || A.NetName == 'DC_RET' || A.NetName == 'Net-(C33-Pad2)' || A.NetName == 'Net-(R44-Pad1)' || A.NetName == 'Net-(R46-Pad1)' || A.NetName == 'Net-(R47-Pad1)' || A.NetName == 'Net-(U14-VIN)' || A.NetName == 'Net-(U8-INN)' || A.NetName == 'Net-(U8-INP)' || A.NetName == 'RECT -' || A.NetName == 'VISO_DC')) || ((A.NetName == 'BIAS_REF' || A.NetName == 'GNDREF' || A.NetName == 'Net-(C29-Pad2)' || A.NetName == 'Net-(R30-Pad1)' || A.NetName == 'Net-(R30-Pad2)' || A.NetName == 'Net-(R31-Pad1)' || A.NetName == 'Net-(U10-IN+)' || A.NetName == 'Net-(U7-VIN)' || A.NetName == 'VAC' || A.NetName == 'VISO_REF') && (B.NetName == '+VDC' || B.NetName == 'DC_RET' || B.NetName == 'Net-(C33-Pad2)' || B.NetName == 'Net-(R44-Pad1)' || B.NetName == 'Net-(R46-Pad1)' || B.NetName == 'Net-(R47-Pad1)' || B.NetName == 'Net-(U14-VIN)' || B.NetName == 'Net-(U8-INN)' || B.NetName == 'Net-(U8-INP)' || B.NetName == 'RECT -' || B.NetName == 'VISO_DC')) || ((B.NetName == 'BIAS_REF' || B.NetName == 'GNDREF' || B.NetName == 'Net-(C29-Pad2)' || B.NetName == 'Net-(R30-Pad1)' || B.NetName == 'Net-(R30-Pad2)' || B.NetName == 'Net-(R31-Pad1)' || B.NetName == 'Net-(U10-IN+)' || B.NetName == 'Net-(U7-VIN)' || B.NetName == 'VAC' || B.NetName == 'VISO_REF') && (A.NetName == '+VDC' || A.NetName == 'DC_RET' || A.NetName == 'Net-(C33-Pad2)' || A.NetName == 'Net-(R44-Pad1)' || A.NetName == 'Net-(R46-Pad1)' || A.NetName == 'Net-(R47-Pad1)' || A.NetName == 'Net-(U14-VIN)' || A.NetName == 'Net-(U8-INN)' || A.NetName == 'Net-(U8-INP)' || A.NetName == 'RECT -' || A.NetName == 'VISO_DC'))")
)

(rule "phase to phase (230 V line-line, about 325 V peak)"
	(constraint clearance (min 2.5mm))
	(condition "(A.NetName == 'ϕA' && B.NetName == 'ϕB') || (A.NetName == 'ϕA' && B.NetName == 'ϕC') || (A.NetName == 'ϕB' && B.NetName == 'ϕA') || (A.NetName == 'ϕB' && B.NetName == 'ϕC') || (A.NetName == 'ϕC' && B.NetName == 'ϕA') || (A.NetName == 'ϕC' && B.NetName == 'ϕB')")
)

(rule "mains line to its neutral side"
	(constraint clearance (min 2.5mm))
	(condition "((A.NetName == 'VAC') && (B.NetName == 'GNDREF' || B.NetName == 'VISO_REF' || B.NetName == 'BIAS_REF' || B.NetName == 'Net-(U10-IN+)' || B.NetName == 'Net-(U7-VIN)' || B.NetName == 'Net-(C29-Pad2)')) || ((B.NetName == 'VAC') && (A.NetName == 'GNDREF' || A.NetName == 'VISO_REF' || A.NetName == 'BIAS_REF' || A.NetName == 'Net-(U10-IN+)' || A.NetName == 'Net-(U7-VIN)' || A.NetName == 'Net-(C29-Pad2)'))")
)

(rule "DC bus to its return side"
	(constraint clearance (min 2.5mm))
	(condition "((A.NetName == '+VDC') && (B.NetName == 'RECT -' || B.NetName == 'DC_RET' || B.NetName == 'VISO_DC' || B.NetName == 'Net-(C33-Pad2)' || B.NetName == 'Net-(U14-VIN)' || B.NetName == 'Net-(U8-INN)' || B.NetName == 'Net-(U8-INP)')) || ((B.NetName == '+VDC') && (A.NetName == 'RECT -' || A.NetName == 'DC_RET' || A.NetName == 'VISO_DC' || A.NetName == 'Net-(C33-Pad2)' || A.NetName == 'Net-(U14-VIN)' || A.NetName == 'Net-(U8-INN)' || A.NetName == 'Net-(U8-INP)'))")
)

(rule "phase to artificial neutral side (about 190 V peak)"
	(constraint clearance (min 1.25mm))
	(condition "((A.NetName == 'ϕA' || A.NetName == 'ϕB' || A.NetName == 'ϕC') && (B.NetName == 'GND_PH' || B.NetName == 'VISO_PH' || B.NetName == 'BIAS_PH' || B.NetName == 'Net-(U4-VIN)' || B.NetName == 'Net-(U5-VIN)' || B.NetName == 'Net-(U6-VIN)' || B.NetName == 'Net-(U9-IN+)' || B.NetName == 'Net-(C37-Pad2)')) || ((B.NetName == 'ϕA' || B.NetName == 'ϕB' || B.NetName == 'ϕC') && (A.NetName == 'GND_PH' || A.NetName == 'VISO_PH' || A.NetName == 'BIAS_PH' || A.NetName == 'Net-(U4-VIN)' || A.NetName == 'Net-(U5-VIN)' || A.NetName == 'Net-(U6-VIN)' || A.NetName == 'Net-(U9-IN+)' || A.NetName == 'Net-(C37-Pad2)'))")
)

(rule "0201 parts: library pad gap is 0.18 mm"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('C4') && B.memberOfFootprint('C4')) || (A.memberOfFootprint('C5') && B.memberOfFootprint('C5')) || (A.memberOfFootprint('C26') && B.memberOfFootprint('C26')) || (A.memberOfFootprint('R43') && B.memberOfFootprint('R43')) || (A.memberOfFootprint('C41') && B.memberOfFootprint('C41')) || (A.memberOfFootprint('R49') && B.memberOfFootprint('R49')) || (A.memberOfFootprint('R3') && B.memberOfFootprint('R3')))")
)
